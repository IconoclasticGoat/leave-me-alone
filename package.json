{
  "name": "leave-me-alone",
  "version": "1.1.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && rm -f leave-me-alone-$npm_package_version.zip && cd dist && zip -qr ../leave-me-alone-$npm_package_version.zip .",
    "test": "vitest run",
    "bundle-rules": "node scripts/bundle-rules.mjs",
    "icons": "node scripts/build-icons.mjs",
    "store-assets": "node scripts/build-store-assets.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2",
    "jsdom": "^24.0.0",
    "vitest": "^4.1.11"
  }
}
