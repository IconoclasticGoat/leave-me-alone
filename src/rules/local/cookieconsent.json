{
  "cookieconsent": {
    "detectors": [
      {
        "presentMatcher": [
          { "type": "css", "target": { "selector": ".cc-window[aria-label='cookieconsent']" } }
        ],
        "showingMatcher": [
          { "type": "css", "target": { "selector": ".cc-window[aria-label='cookieconsent']", "displayFilter": true } }
        ]
      }
    ],
    "methods": [
      { "name": "OPEN_OPTIONS" },
      { "name": "DO_CONSENT" },
      {
        "action": {
          "type": "ifcss",
          "target": { "selector": ".cc-window[aria-label='cookieconsent'] .cc-btn.cc-deny" },
          "trueAction": { "type": "click", "target": { "selector": ".cc-window[aria-label='cookieconsent'] .cc-btn.cc-deny" } },
          "falseAction": { "type": "click", "target": { "selector": ".cc-window[aria-label='cookieconsent'] .cc-btn.cc-dismiss, .cc-window[aria-label='cookieconsent'] .cc-close" } }
        },
        "name": "SAVE_CONSENT"
      },
      {
        "action": { "type": "hide", "target": { "selector": ".cc-window[aria-label='cookieconsent']" } },
        "name": "HIDE_CMP"
      },
      { "name": "UTILITY" }
    ]
  }
}
